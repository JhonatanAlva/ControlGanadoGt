{
  "expo": {
    "name": "GanaderíaGT",
    "slug": "ganaderia-gt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ganaderiagt",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ganaderiagt.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2d7a3a"
      },
      "package": "com.ganaderiagt.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a GanaderíaGT acceder a tus fotos para agregar imágenes de tus animales.",
          "cameraPermission": "Permite a GanaderíaGT usar la cámara para tomar fotos de tus animales."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2d7a3a",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

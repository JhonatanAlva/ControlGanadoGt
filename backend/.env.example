# Servidor
NODE_ENV=development
PORT=3000

# Base de datos: usuario de permisos mínimos (APP_DB_USER / APP_DB_PASSWORD del .env de la raíz).
# Nunca uses aquí el superusuario de PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ganadogt_app
DB_PASSWORD=
DB_NAME=controlganado_db
# true si PostgreSQL está en otro servidor (producción)
DB_SSL=false

# JWT — mínimo 32 caracteres. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seguridad (producción)
# Orígenes web permitidos, separados por coma. La app móvil no lo necesita.
CORS_ORIGIN=
# Número de proxies delante del API (0 si no hay ninguno)
TRUST_PROXY=0

# Correo (alertas de vacunas y partos)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pagadito
PAGADITO_UID=
PAGADITO_WSK=

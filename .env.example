# Variables que lee docker-compose.yml. Copia a .env y llena los valores.
# Genera cada secreto con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

DB_USER=ganadogt
DB_PASSWORD=
DB_NAME=controlganado_db
DB_PORT=5432

# Usuario con permisos mínimos que usa el API (lo crea migrations/003_rol_app.sh)
APP_DB_USER=ganadogt_app
APP_DB_PASSWORD=

PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Mínimo 32 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGIN=
TRUST_PROXY=0

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frase para cifrar respaldos (scripts/respaldo-db.sh). Guárdala también fuera de esta PC.
BACKUP_PASSPHRASE=
